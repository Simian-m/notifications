{
  "name": "simianbv/notification-broker",
  "description": "Subscription-based notification broker for Laravel",
  "type": "library",
  "keywords": [
    "laravel",
    "notifications",
    "subscriptions"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Simian",
      "email": "it@simian.nl"
    }
  ],
  "require": {
    "php": "^8.1|^8.2|^8.3",
    "laravel/framework": "^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "Simianbv\\Notifications\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Simianbv\\Notifications\\NotificationBrokerServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable"
}
